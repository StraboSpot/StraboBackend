# Copy to .env (gitignored) next to the compose file and fill in.
# The token's sha256 goes in the server's config.inc.php VOICESTATIONS_WORKERS
# under this worker's name (with its claim delay); the plain token only here.
#   make one:  openssl rand -hex 32
#   its hash:  printf '%s' "<token>" | sha256sum
VS_API_URL=https://strabospot.org/voiceworker/v1
VS_TOKEN=
VS_KINDS=transcribe
VS_THREADS=8
# Host folder holding ggml-large-v3-turbo.bin and ggml-silero-v5.1.2.bin
VS_MODELS_HOST_DIR=/path/to/whisper-models
