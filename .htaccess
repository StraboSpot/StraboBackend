php_value memory_limit 4086M
# No Apache "Index of" pages anywhere: data folder file names (version uuids, micro files) act as access keys
Options -Indexes
# StraboMicro project.json (straboMicroFiles/, microview/smzFiles/, straboMicroView/smzFiles/)
# changes in place on every upload and sync build; without this, browsers reuse a stale copy
# for minutes (heuristic freshness) and the web viewers miss new edits until a hard reload.
# no-cache = revalidate each time (a 304 when unchanged). Tiles and images keep default caching.
<IfModule mod_headers.c>
<FilesMatch "^project\.json$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
RewriteEngine on
# Export Builder job data (exportjobs_data/, gitignored): never served; exportjobs/download.php streams results
RewriteRule ^exportjobs_data(/|$) - [F,L]
# StraboMicro sync (microsync): partial uploads and content-addressed blobs are served only by the
# authenticated /microsync/v1/ API (also through the microview/smzFiles symlink); worker data never
RewriteRule ^(straboMicroFiles|microview/smzFiles)/_staging(/|$) - [F,L]
# Pre-conversion project.zip archives and journals (microsync/tools/convert.php): never served
RewriteRule ^(straboMicroFiles|microview/smzFiles)/_archive(/|$) - [F,L]
RewriteRule ^(straboMicroFiles|microview/smzFiles)/[0-9]+/blobs(/|$) - [F,L]
RewriteRule ^microsync_data(/|$) - [F,L]
# Synced StraboMicro projects have no static project.zip; the app still asks for that URL
# (getProjectURL, getSharedURL, share codes), so a missing one is streamed by
# download_micro_file.php (microsync/lib/MsSmz.php). Existing files are served as before.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^straboMicroFiles/([0-9]+)/project\.zip$ download_micro_file.php?project_id=$1 [L]
RewriteRule ^validate/(.*)$ validateuser.php?hash=$1 [L]
RewriteRule ^passwdreset/(.*)$ passwordreset.php?hash=$1 [L]
RewriteRule ^changeemail/(.*)$ confirmemailchange.php?token=$1 [L]
RewriteRule ^viewdataset/(.*)$ view_dataset.php?id=$1 [L]
RewriteRule ^help/(.*)$ helppage.php?extra=$1 [L]
RewriteRule ^map_warper_check/(.*)$ mwcheck.php?id=$1 [L]
RewriteRule ^strabo_mymaps_check/(.*)$ mymapscheck.php?hash=$1 [L]
#RewriteRule ^help helppage.php [L]
RewriteRule ^kobo.json$ kobojson.php [L]
RewriteRule ^mwproxy/(.*)$ mapwarperproxy.php?data=$1 [L]
RewriteRule ^pi/(.*)$ publicimage.php?id=$1 [L]
RewriteRule ^pi_thumbnail/(.*)$ publicthumbnailimage.php?id=$1 [L]
RewriteRule ^pi_basemap/(.*)/(.*)$ publicthumbnailimage.php?thumbsize=$1&id=$2 [L]
RewriteRule ^randomdatasets.json$ randomdatasetsjson.php [L]
RewriteRule ^searchdatasets.json$ searchdatasetsjson.php [L]
RewriteRule ^searchspots.json$ searchspotsjson.php [L]
RewriteRule ^includes/mapsearch/data_model.js$ jsdatamodel.php [L]
RewriteRule ^search/includes/data_model.js$ jsdatamodel.php [L]
RewriteRule ^mapimage/(.*).jpg$ publicimage.php?id=$1 [L]
RewriteRule ^stereonetoutput/(.*)$ stereonetout.php?id=$1 [L]
RewriteRule ^stereonet/(.*)$ stereonetout.php?id=$1 [L]
RewriteRule ^labbook/(.*)$ exportlabbook.php?id=$1 [L]
RewriteRule ^fieldbook/(.*)$ exportfieldbook.php?id=$1 [L]
RewriteRule ^shapefile/(.*)$ exportshapefile?id=$1 [L]
RewriteRule ^kml/(.*)$ exportkml?id=$1 [L]
RewriteRule ^xls/(.*)$ datasetxls?id=$1 [L]
RewriteRule ^dl/(.*)/(.*)$ searchdownload.php?type=$1&dsids=$2 [L]
#RewriteRule ^logMicroInstall/(.*)/(.*)$ dologmicroinstall.php?p=$1&ver=$2 [L]
RewriteRule ^geimage/(.*)$ google_earth_image.php?id=$1 [L]
RewriteRule ^debugproject/(.*)$ debugprojectscript.php?project_id=$1 [L]
RewriteRule ^projectgeojson/(.*)$ projectgeojsonscript.php?project_id=$1 [L]
RewriteRule ^projectjson/(.*)$ outprojectjson.php?project_id=$1 [L]
RewriteRule ^sitemap1.xml$ sitemapxml.php [L]
RewriteRule ^sitemap1.xml$ sitemapxml.php [L]
RewriteRule ^spot/(.*)$ spotjson?id=$1 [L]
RewriteRule ^instrument_list.js$ instrumentlist.php [L]
RewriteRule ^instrument_detail/(.*)$ instrumentdetail.php?pkey=$1 [L]
RewriteRule ^expimageupload/(.*)/(.*)/(.*)$ experimental_image_upload.php?type=$1&pkey=$2&sensor_num=$3 [L]
RewriteRule ^expimageupload/(.*)/(.*)$ experimental_image_upload.php?type=$1&pkey=$2 [L]
RewriteRule ^expimagedelete/(.*)/(.*)/(.*)$ experimental_image_delete.php?type=$1&pkey=$2&sensor_num=$3 [L]
RewriteRule ^expimagedelete/(.*)/(.*)$ experimental_image_delete.php?type=$1&pkey=$2 [L]
RewriteRule ^sensor_calibration_file/(.*)/(.*)/(.*)$ experimental_sensor_calibration_file_download.php?type=$1&apparatus_pkey=$2&sensor_num=$3 [L]
RewriteRule ^sensor_calibration_file/electrical/(.*)$ experimental_sensor_calibration_file_download.php?type=electrical&apparatus_pkey=$1 [L]
RewriteRule ^assets/js/apparatus/add_apparatus_(.*).js$ add_apparatus_js.php?pkey=$1 [L]
RewriteRule ^apparatus_photo_(.*)_small.jpg$ apparatusphoto.php?pkey=$1&size=small [L]
RewriteRule ^apparatus_photo_(.*)_large.jpg$ apparatusphoto.php?pkey=$1&size=large [L]
RewriteRule ^apparatus_schematic_(.*)$ apparatusschematic.php?pkey=$1 [L]
RewriteRule ^d/(.*)$ land?h=$1 [L]
RewriteRule ^i/(.*)/(.*)$ /experimental/view_experimental_uploaded_file.php?uuid=$1&original_filename=$2 [B]
RewriteRule ^fdl/(.*)$ dl_field_zip.php?u=$1 [L]
RewriteRule ^fpl/(.*)$ field_project_landing_page.php?p=$1 [L]
RewriteRule ^mpl/(.*)$ micro_project_landing_page.php?p=$1 [L]
RewriteRule ^epl/(.*)$ experimental_project_landing_page.php?p=$1 [L]
RewriteRule ^manual/(.*)$ manual_download.php?t=$1 [L]
RewriteRule ^igsn/(.*)$ igsnland.php?igsn=$1 [L]
RewriteRule ^aidescription/(.*)$ aidesccurl.php?image_id=$1 [L]
RewriteRule ^aidescription2/(.*)$ aidesccurl2.php?image_id=$1 [L]
RewriteRule ^samples/([^/]+)/([^/]+)/?$ samples_detail.php?owner=$1&id=$2 [L,QSA]




